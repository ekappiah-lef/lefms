# Copy this file to .env.
#
# Plain `npm run dev` (Vite) only reads VITE_API_URL. Everything else
# below is read by `docker compose` (docker-compose.yml) when running the
# full stack in containers.

# --- Frontend (Vite) ---
# Local dev against the API on your machine:
VITE_API_URL="http://localhost:4000/api"
# For docker compose instead, leave this as the default relative path so
# the built frontend calls same-origin through nginx's proxy:
# VITE_API_URL=/api

# --- Database (docker compose) ---
DB_ROOT_PASSWORD=change-this-root-password
DB_USER=lefms
DB_PASSWORD=change-this-password
DB_NAME=lefms

# --- Backend (docker compose) ---
JWT_SECRET=change-this-to-a-long-random-string
# How long a login session lasts before the app forces a re-login.
JWT_EXPIRES_IN=12h
# Comma-separated list of origins allowed to call this API, e.g.
# https://lefms.example.com   leave blank only for local dev.
CORS_ORIGIN=

# SMSOnlineGH (https://dev.smsonlinegh.com/docs) - leave blank to disable SMS alerts
SMS_API_KEY=
SMS_SENDER_ID=

# --- Image tags (docker compose / CI) ---
# Which registry/tag `docker compose build|pull|up` uses for the backend
# and frontend images, e.g. ghcr.io/your-org or 123456789.dkr.ecr.us-east-1.amazonaws.com/lefms
REGISTRY=lefms
IMAGE_TAG=latest
