# Copy to .env and adjust for your XAMPP MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lefms
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# SMSOnlineGH (https://dev.smsonlinegh.com/docs) - engineer/group alerts.
# Leave unset to disable SMS entirely (attempts are logged as failed with
# a clear reason, nothing else breaks).
SMS_API_KEY=
SMS_SENDER_ID=
