# Copy to .env and adjust for your XAMPP MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lefms
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
# How long a login session lasts before the app forces a re-login.
JWT_EXPIRES_IN=12h
# Comma-separated allowed origins for the API, e.g. https://lefms.example.com
# Leave blank only for local dev (allows any origin).
CORS_ORIGIN=

# SMSOnlineGH (https://dev.smsonlinegh.com/docs) - engineer/group alerts.
# Leave unset to disable SMS entirely (attempts are logged as failed with
# a clear reason, nothing else breaks).
SMS_API_KEY=
SMS_SENDER_ID=
